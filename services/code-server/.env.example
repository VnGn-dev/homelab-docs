# Copie para .env e preencha:  cp .env.example .env
# O .env NÃO vai para o Git (já está no .gitignore).

# Seu usuário e grupo no servidor (descubra com o comando: id)
PUID=1000
PGID=1000

TZ=America/Sao_Paulo

# Senha para entrar no code-server
PASSWORD=troque-esta-senha

# Pasta das configurações e extensões do code-server (no SSD)
CONFIG_DIR=/srv/ssd/code-server/config

# Pasta dos projetos no servidor (no SSD de projetos)
PROJECTS_DIR=/srv/ssd/projetos

# IP do servidor no Tailscale (descubra com: tailscale ip -4)
BIND_IP=100.x.x.x
